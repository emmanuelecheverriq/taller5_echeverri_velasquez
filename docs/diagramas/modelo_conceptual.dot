graph G {
 layout=neato; overlap=false; splines=true; sep="+12"; node [fontname="Helvetica", fontsize=10]; edge [fontname="Helvetica", fontsize=9];
  MAQUINA [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#dae8fc"><B>MAQUINA</B></TD></TR><TR><TD ALIGN="LEFT">nombre</TD></TR></TABLE>>];
  TURNO [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#dae8fc"><B>TURNO</B></TD></TR><TR><TD ALIGN="LEFT">nombre</TD></TR><TR><TD ALIGN="LEFT">hora_inicio</TD></TR><TR><TD ALIGN="LEFT">hora_fin</TD></TR></TABLE>>];
  PERSONA [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#dae8fc"><B>PERSONA</B></TD></TR><TR><TD ALIGN="LEFT">codigo_seudonimo</TD></TR><TR><TD ALIGN="LEFT">tipo_persona</TD></TR></TABLE>>];
  REFERENCIA [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#dae8fc"><B>REFERENCIA</B></TD></TR><TR><TD ALIGN="LEFT">nombre</TD></TR><TR><TD ALIGN="LEFT">marca</TD></TR><TR><TD ALIGN="LEFT">volumen_cc</TD></TR><TR><TD ALIGN="LEFT">num_colores</TD></TR></TABLE>>];
  REGISTRO_PRODUCCION [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#dae8fc"><B>REGISTRO_PRODUCCION</B></TD></TR><TR><TD ALIGN="LEFT">fecha</TD></TR><TR><TD ALIGN="LEFT">secuencia</TD></TR><TR><TD ALIGN="LEFT">pacas_producidas</TD></TR><TR><TD ALIGN="LEFT">horas_trabajadas</TD></TR><TR><TD ALIGN="LEFT">observaciones</TD></TR></TABLE>>];
  PARO [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#dae8fc"><B>PARO</B></TD></TR><TR><TD ALIGN="LEFT">minutos</TD></TR><TR><TD ALIGN="LEFT">equipo_ejecutor</TD></TR></TABLE>>];
  CODIGO_PARO [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#dae8fc"><B>CODIGO_PARO</B></TD></TR><TR><TD ALIGN="LEFT">numero</TD></TR><TR><TD ALIGN="LEFT">nombre</TD></TR></TABLE>>];
  SUBCODIGO_PARO [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#dae8fc"><B>SUBCODIGO_PARO</B></TD></TR><TR><TD ALIGN="LEFT">codigo_sub</TD></TR><TR><TD ALIGN="LEFT">descripcion</TD></TR><TR><TD ALIGN="LEFT">nivel</TD></TR></TABLE>>];
  AREA_IMPACTO [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#dae8fc"><B>AREA_IMPACTO</B></TD></TR><TR><TD ALIGN="LEFT">nombre</TD></TR></TABLE>>];
  PARADA_MAQUINA [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#dae8fc"><B>PARADA_MAQUINA</B></TD></TR><TR><TD ALIGN="LEFT">fecha</TD></TR><TR><TD ALIGN="LEFT">horas_no_trabajadas</TD></TR><TR><TD ALIGN="LEFT">observacion</TD></TR></TABLE>>];
  MOTIVO_PARADA [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#dae8fc"><B>MOTIVO_PARADA</B></TD></TR><TR><TD ALIGN="LEFT">sistema_codificacion</TD></TR><TR><TD ALIGN="LEFT">codigo</TD></TR><TR><TD ALIGN="LEFT">nombre</TD></TR></TABLE>>];
  R0 [shape=diamond, style=filled, fillcolor="#fff2cc", label="tiene", fontsize=9];
  MAQUINA -- R0 [label="1", headlabel="", len=1.6];
  R0 -- REGISTRO_PRODUCCION [label="N", len=1.6];
  R1 [shape=diamond, style=filled, fillcolor="#fff2cc", label="ocurre en", fontsize=9];
  TURNO -- R1 [label="1", headlabel="", len=1.6];
  R1 -- REGISTRO_PRODUCCION [label="N", len=1.6];
  R2 [shape=diamond, style=filled, fillcolor="#fff2cc", label="opera", fontsize=9];
  PERSONA -- R2 [label="0..1", headlabel="", len=1.6];
  R2 -- REGISTRO_PRODUCCION [label="N", len=1.6];
  R3 [shape=diamond, style=filled, fillcolor="#fff2cc", label="se produce en", fontsize=9];
  REFERENCIA -- R3 [label="0..1", headlabel="", len=1.6];
  R3 -- REGISTRO_PRODUCCION [label="N", len=1.6];
  R4 [shape=diamond, style=filled, fillcolor="#fff2cc", label="registra", fontsize=9];
  REGISTRO_PRODUCCION -- R4 [label="1", headlabel="", len=1.6];
  R4 -- PARO [label="N", len=1.6];
  R5 [shape=diamond, style=filled, fillcolor="#fff2cc", label="clasifica", fontsize=9];
  CODIGO_PARO -- R5 [label="1", headlabel="", len=1.6];
  R5 -- PARO [label="N", len=1.6];
  R6 [shape=diamond, style=filled, fillcolor="#fff2cc", label="detalla", fontsize=9];
  SUBCODIGO_PARO -- R6 [label="0..1", headlabel="", len=1.6];
  R6 -- PARO [label="N", len=1.6];
  R7 [shape=diamond, style=filled, fillcolor="#fff2cc", label="se divide en", fontsize=9];
  CODIGO_PARO -- R7 [label="1", headlabel="", len=1.6];
  R7 -- SUBCODIGO_PARO [label="N", len=1.6];
  R8 [shape=diamond, style=filled, fillcolor="#fff2cc", label="impacta", fontsize=9];
  AREA_IMPACTO -- R8 [label="0..1", headlabel="", len=1.6];
  R8 -- CODIGO_PARO [label="N", len=1.6];
  R9 [shape=diamond, style=filled, fillcolor="#fff2cc", label="se detiene", fontsize=9];
  MAQUINA -- R9 [label="1", headlabel="", len=1.6];
  R9 -- PARADA_MAQUINA [label="N", len=1.6];
  R10 [shape=diamond, style=filled, fillcolor="#fff2cc", label="explica", fontsize=9];
  MOTIVO_PARADA -- R10 [label="1", headlabel="", len=1.6];
  R10 -- PARADA_MAQUINA [label="N", len=1.6];
  R11 [shape=diamond, style=filled, fillcolor="#fff2cc", label="interviene", fontsize=9];
  PERSONA -- R11 [label="0..1", headlabel="", len=1.6];
  R11 -- PARO [label="N", len=1.6];
}
