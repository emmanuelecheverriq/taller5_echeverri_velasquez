digraph G {
 rankdir=LR; splines=true; nodesep=0.45; ranksep=1.0; node [shape=plain, fontname="Helvetica", fontsize=10]; edge [fontname="Helvetica", fontsize=8, color="#444444"];
  "maquina" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dae8fc"><B>maquina</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">PK</FONT></TD><TD ALIGN="LEFT">id_maquina</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">activa</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">BOOLEAN</FONT></TD></TR></TABLE>>];
  "turno" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dae8fc"><B>turno</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">PK</FONT></TD><TD ALIGN="LEFT">id_turno</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">hora_inicio</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TIME</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">hora_fin</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TIME</FONT></TD></TR></TABLE>>];
  "area_impacto" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dae8fc"><B>area_impacto</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">PK</FONT></TD><TD ALIGN="LEFT">id_area</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(40)</FONT></TD></TR></TABLE>>];
  "codigo_paro" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dae8fc"><B>codigo_paro</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">PK</FONT></TD><TD ALIGN="LEFT">id_codigo_paro</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">FK</FONT></TD><TD ALIGN="LEFT">id_area</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR></TABLE>>];
  "subcodigo_paro" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dae8fc"><B>subcodigo_paro</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">PK</FONT></TD><TD ALIGN="LEFT">id_subcodigo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">FK</FONT></TD><TD ALIGN="LEFT">id_codigo_paro</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">codigo_sub</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">descripcion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">FK</FONT></TD><TD ALIGN="LEFT">id_subcodigo_padre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">nivel</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR></TABLE>>];
  "equivalencia_subcodigo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dae8fc"><B>equivalencia_subcodigo</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">PK</FONT></TD><TD ALIGN="LEFT">texto_origen</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">FK</FONT></TD><TD ALIGN="LEFT">id_subcodigo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR></TABLE>>];
  "motivo_parada" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dae8fc"><B>motivo_parada</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">PK</FONT></TD><TD ALIGN="LEFT">id_motivo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">sistema_codificacion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">codigo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(120)</FONT></TD></TR></TABLE>>];
  "referencia" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dae8fc"><B>referencia</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">PK</FONT></TD><TD ALIGN="LEFT">id_referencia</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">marca</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">volumen_cc</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">num_colores</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR></TABLE>>];
  "persona" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dae8fc"><B>persona</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">PK</FONT></TD><TD ALIGN="LEFT">id_persona</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">codigo_seudonimo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">tipo_persona</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(13)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">activa</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">BOOLEAN</FONT></TD></TR></TABLE>>];
  "privado.persona_identidad" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#fce5cd"><B>privado.persona_identidad</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">PK/FK</FONT></TD><TD ALIGN="LEFT">id_persona</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">nombre_completo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">fecha_carga</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TIMESTAMP</FONT></TD></TR></TABLE>>];
  "registro_produccion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9ead3"><B>registro_produccion</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">PK</FONT></TD><TD ALIGN="LEFT">id_registro</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">fecha</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">FK</FONT></TD><TD ALIGN="LEFT">id_maquina</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">FK</FONT></TD><TD ALIGN="LEFT">id_turno</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">secuencia</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">FK</FONT></TD><TD ALIGN="LEFT">id_persona</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">FK</FONT></TD><TD ALIGN="LEFT">id_referencia</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">pacas_producidas</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">horas_trabajadas</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">NUMERIC(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">es_sintetico</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">observaciones</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(500)</FONT></TD></TR></TABLE>>];
  "paro" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9ead3"><B>paro</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">PK</FONT></TD><TD ALIGN="LEFT">id_paro</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">FK</FONT></TD><TD ALIGN="LEFT">id_registro</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">FK</FONT></TD><TD ALIGN="LEFT">id_codigo_paro</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">FK</FONT></TD><TD ALIGN="LEFT">id_subcodigo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">minutos</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">NUMERIC(7,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">equipo_ejecutor</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(13)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">FK</FONT></TD><TD ALIGN="LEFT">id_persona</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR></TABLE>>];
  "parada_maquina" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#d9ead3"><B>parada_maquina</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">PK</FONT></TD><TD ALIGN="LEFT">id_parada</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">fecha</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">FK</FONT></TD><TD ALIGN="LEFT">id_maquina</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">FK</FONT></TD><TD ALIGN="LEFT">id_motivo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">horas_no_trabajadas</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">NUMERIC(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#b00020">&nbsp;</FONT></TD><TD ALIGN="LEFT">observacion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(200)</FONT></TD></TR></TABLE>>];
  "maquina" -> "registro_produccion" [dir=both, arrowtail=tee, arrowhead=crow, label="tiene"];
  "turno" -> "registro_produccion" [dir=both, arrowtail=tee, arrowhead=crow, label="en"];
  "persona" -> "registro_produccion" [dir=both, arrowtail=teeodot, arrowhead=crow, label="opera"];
  "referencia" -> "registro_produccion" [dir=both, arrowtail=teeodot, arrowhead=crow, label="produce"];
  "registro_produccion" -> "paro" [dir=both, arrowtail=tee, arrowhead=crow, label="pierde tiempo en"];
  "codigo_paro" -> "paro" [dir=both, arrowtail=tee, arrowhead=crow, label="clasifica"];
  "subcodigo_paro" -> "paro" [dir=both, arrowtail=teeodot, arrowhead=crow, label="detalla"];
  "persona" -> "paro" [dir=both, arrowtail=teeodot, arrowhead=crow, label="interviene"];
  "area_impacto" -> "codigo_paro" [dir=both, arrowtail=teeodot, arrowhead=crow, label="impacta"];
  "codigo_paro" -> "subcodigo_paro" [dir=both, arrowtail=tee, arrowhead=crow, label="se divide en"];
  "subcodigo_paro" -> "subcodigo_paro" [dir=both, arrowtail=teeodot, arrowhead=crow, label="contiene"];
  "subcodigo_paro" -> "equivalencia_subcodigo" [dir=both, arrowtail=tee, arrowhead=crow, label="homologa"];
  "maquina" -> "parada_maquina" [dir=both, arrowtail=tee, arrowhead=crow, label="se detiene"];
  "motivo_parada" -> "parada_maquina" [dir=both, arrowtail=tee, arrowhead=crow, label="explica"];
  "persona" -> "privado.persona_identidad" [dir=both, arrowtail=tee, arrowhead=teeodot, label="identidad (1:1)", style=dashed];
}
